include oxi/Makefile
include oxi/server.jl
recursive-include oxi/src *
recursive-include oxi/apps/static *

# STRIP HEAVY MEDIA FILES (Copyright & Weight reasons)
global-exclude *.mp4
global-exclude *.mp3
global-exclude *.webm
global-exclude *.webp
global-exclude *.avi
global-exclude *.zip
global-exclude sessions *